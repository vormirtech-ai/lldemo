{
  "name": "catering-pos",
  "version": "1.0.0",
  "description": "Catering Service Management + POS (Quotations, Bills, POS) — offline-first PWA / Android",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "cap:sync": "APK=1 npm run build && npx cap sync android",
    "apk:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "dexie": "^4.4.7",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "pdfjs-dist": "^6.5.438",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "private": true,
  "type": "module"
}